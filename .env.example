# Generate a high-entropy value, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Must exactly match the redirect URI registered through Swiggy Dynamic Client
# Registration. Swiggy documents this localhost URI for local development.
SWIGGY_REDIRECT_URI=http://localhost/callback

# Official Swiggy MCP endpoints. Leave these at their documented defaults.
SWIGGY_OAUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food

# The browser application allowed to make credentialed requests to this local API.
FRONTEND_ORIGIN=http://localhost:3000
